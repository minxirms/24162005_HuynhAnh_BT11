<?xml version="1.0" encoding="UTF-8"?>
<sitemesh>
	<!-- Bỏ qua các trang static và authen -->
	<mapping path="/login" exclude="true" />
	<mapping path="/register" exclude="true" />
	<mapping path="/forgot-password" exclude="true" />
	<mapping path="/verify-account" exclude="true" />
	<mapping path="/api/*" exclude="true" />
	<mapping path="/uploads/*" exclude="true" />
	<mapping path="/assets/*" exclude="true" />
	<mapping path="/templates/*" exclude="true" />

	<!-- Layout Admin -->
	<mapping path="/admin/*" decorator="/WEB-INF/views/decorators/admin.jsp" />

	<!-- Layout User / Mặc định -->
	<mapping path="/*" decorator="/WEB-INF/views/decorators/user.jsp" />
</sitemesh>